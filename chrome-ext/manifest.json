{
  "manifest_version": 3,
  "name": "XRAI · Universal Remix Dashboard",
  "short_name": "XRAI",
  "version": "0.1.0",
  "description": "Every webpage, every graphic, every idea — transparent, remixable, sharable in real time across virtual and real worlds.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "XRAI dash",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["popout.html", "sidepanel.html", "inject.js", "vendor/*"],
    "matches": ["<all_urls>"]
  }],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "toggle-dash": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Toggle XRAI dashboard on current page"
    },
    "popout-graph": {
      "suggested_key": { "default": "Ctrl+Shift+G", "mac": "Command+Shift+G" },
      "description": "Pop out 3D node graph in its own window"
    }
  }
}
