      "id": "therarp",
      "name": "TherArp (the Divine Conductor)",
      "kind": "interaction",
      "rule": "two hands steer one clocked generator over a consonant set",
      "rule4": {
        "D": "tick k on a grid (16ths); two controls, frame hand a and voice hand b, each in [0,1] or absent",
        "F": "note_k = P[ base(b.y) + pattern(k, span(|a.x - b.x|)) ]  with P a consonant set repeated by octaves",
        "O": "at each tick, sample and hold the eased controls: voice(note_k, tone(a.y), level(presence, rest))",
        "A": "voices sum into echo and space; controls ease one-pole (tau), register changes past a hysteresis margin"
      },
      "why_it_works": [
        "no wrong notes: every index lands in a consonant set",
        "sound before skill: the clock never waits for the player",
        "gestures land on the beat: controls are sampled once per tick",
        "up means more: the voice hand climbs register, the frame hand opens brightness",
        "a trembling hand never stutters: easing plus hysteresis",
        "depth to master: span from hand spread, rest by pinch, energy sets density"
      ],
      "bindings": [
        {
          "name": "COSMOS",
          "measured_from": "AI Studio prototype XRAI - COSMOS, src/hooks/useArpSynth.ts",
