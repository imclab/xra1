        "F": "theta_j = j * (pi + 2*pi/T)",
        "O": "pose_j = (r sin theta_j, -y_j, r cos theta_j), facing out from the axis; strand = j mod 2",
        "A": "none: stateless. A viewer at fractional p faces theta(p), easing between items by smoothstep"
      },
      "params": {
        "T": {
          "default": 10.5,
          "unit": "items per turn",
